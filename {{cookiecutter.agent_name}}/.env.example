# Application
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=text
APP_LOG_TO_CONSOLE=true
APP_LOG_DIR=logs
APP_DEVICE_ID=dev-device-001
APP_HARDWARE_PROFILE=fake

# Host supervisor (Runtime API) — not device-root MQTT
HOST_SUPERVISOR_ENDPOINT=unix:///tmp/host-supervisor.sock
HOST_SUPERVISOR_ENABLED=true
HOST_SUPERVISOR_TIMEOUT_SECONDS=5.0

# Buffers (disk-backed)
BUFFER_DATA_DIR=data/buffers
BUFFER_METRICS_MAX_ROWS=10000
BUFFER_CAPTURE_MAX_ROWS=1000

# Engine runtime (image family is a product ADR)
ENGINE_CONTAINER_NAME=inference-engine
ENGINE_IMAGE=inference-engine:latest
ENGINE_ENABLED=false

# Scrape
SCRAPE_ENDPOINT=http://localhost:8002/metrics
SCRAPE_INTERVAL_SECONDS=30
